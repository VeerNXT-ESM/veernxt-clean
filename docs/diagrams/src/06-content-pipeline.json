  "cards": [
    {
      "dot": "emerald",
      "title": "In this repo",
      "items": [
        "The Publish Content page converts and publishes one DOCX at a time",
        "Parser: scripts/lib/docxParser.mjs (headings from Word Heading 1 styles)"
      ]
    },
    {
      "dot": "rose",
      "title": "Not in this repo",
      "items": [
        "The newer direct parser, verifier and bulk runner stay in the original repo",
        "50 re-parsed books exist as Draft rows on the live site, not yet swapped in"
      ]
    },
    {
      "dot": "amber",
      "title": "Linking",
      "items": [
        "A book reaches an exam through lc_exam_resource_map or the legacy exam_name match",
        "Purging legacy rows before real links exist hides books from those exams"
      ]
    }
  ]
