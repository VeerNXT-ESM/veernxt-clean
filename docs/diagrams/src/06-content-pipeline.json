      "label": "chapter JSON",
      "variant": "default"
    },
    {
      "id": "f6",
      "from": "publish",
      "to": "res",
      "label": "new row",
      "variant": "default"
    },
    {
      "id": "f7",
      "from": "page",
      "to": "map",
