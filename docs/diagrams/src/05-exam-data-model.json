  "cards": [
    {
      "dot": "rose",
      "title": "Two exam tables",
      "items": [
        "lc_exams is the current table, exams is the legacy one",
        "lc_exam_legacy_map joins them: legacy_exam_id is plain text, not a key",
        "jobs carry both exam_id (legacy) and lc_exam_id; the profiling engine still reads exams"
      ]
    },
    {
      "dot": "amber",
      "title": "Logical joins",
      "items": [
        "resource_id, quiz_id and legacy_exam_id have no foreign key in the database",
        "Two content tables exist: resources and resources_v2 (same columns)",
        "Also real but not drawn: exams and quizzes foreign keys to the tables above"
      ]
    },
    {
      "dot": "cyan",
      "title": "Source of this picture",
      "items": [
        "Read from the live API schema on 2026-11-01: columns trimmed to the keys and a few fields",
        "47 tables and views in total; schema.sql in the repo may be out of date"
      ]
    }
  ]
