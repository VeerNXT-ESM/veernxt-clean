  "cards": [
    {
      "dot": "emerald",
      "title": "Existing users",
      "items": [
        "Skip the OTP: the SPA calls signInWithPassword directly",
        "Password reset uses the same OTP step, then /api/auth/reset-password"
      ]
    },
    {
      "dot": "rose",
      "title": "Good to know",
      "items": [
        "OTP verify is stateless: the signed otpToken carries the proof",
        "If MSG91 keys are missing the API simulates a send (dev mode, code 123456)",
        "Production must have MSG91_AUTH_KEY and MSG91_TEMPLATE_ID set"
      ]
    }
  ]
