# Copy to .env next to main.js. NEVER commit .env. Values come from the team password manager.

# ---- Database (the site's Supabase project) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server-level key: it bypasses RLS. Use a TEST project until you trust a run.
# JOBS_TABLE=jobs_v2            # table the scraper reads and writes (default jobs_v2)

# ---- AI (job filtering and descriptions). Pick one provider ----
AI_PROVIDER=openai              # openai (default) | openrouter | custom

# openai:
OPENAI_API_KEY=
# AI_MODEL=gpt-4o-mini          # chat model. Reasoning models (o-series, gpt-5) reject max_tokens/temperature: use a standard chat model

# openrouter:
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# custom (any OpenAI-compatible chat-completions endpoint):
# AI_API_URL=
# AI_API_KEY=
# AI_MODEL=

# AI_TIMEOUT_MS=60000             # filter batch timeout
# AI_DESC_TIMEOUT_MS=90000        # description timeout
