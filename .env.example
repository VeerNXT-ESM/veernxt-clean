# Copy to .env and fill in. NEVER commit .env. Real values are in the team password manager.
# Names only here. Anything starting with VITE_ is compiled into the public browser bundle.

# ---- Supabase ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=      # server only
SUPABASE_JWT_SECRET=            # server only; also signs the OTP token in api/auth/otp.js
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=         # public by design; RLS protects the data
# SUPABASE_ANON_KEY=            # only used as a fallback in one API file

# ---- Admin API ----
ADMIN_API_SECRET=               # server: checked by api/admin/*
VITE_ADMIN_API_SECRET=          # client copy of the same value. PUBLIC in the bundle: see docs/SECURITY_NOTES.md

# ---- Cloudflare R2 ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=           # server only
R2_BUCKET_NAME=                 # veernxt-resources
R2_PUBLIC_URL=                  # public address of the bucket
VITE_R2_PUBLIC_URL=             # same address for the browser. If unset, r2Uploader.js falls back to a stale address

# ---- MSG91 (OTP, SMS, WhatsApp) ----
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SMS_FLOW_ID=
MSG91_JOB_SMS_FLOW_ID=
MSG91_JOB_ALERT_FLOW_ID=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_HR_NUMBER=
# If MSG91_AUTH_KEY / MSG91_TEMPLATE_ID are missing the API simulates OTP sending (dev mode, code 123456).

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=            # server only
VITE_RAZORPAY_KEY_ID=           # public key id

# ---- Email (Gmail SMTP, used by api/_lib/emailBroadcaster.js) ----
SMTP_USER=
SMTP_PASS=                      # app password, server only

# ---- Misc ----
VITE_ENGINE_URL=                # optional: external engine URL (src/lib/supabase.js, Render fallback)
# DEVTEST=true                  # skips the Razorpay amount check in api/payments/actions.js. MUST stay unset in production
